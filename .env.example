# Copy to `.env` and edit. Vars MUST be prefixed with EXPO_PUBLIC_ to be readable on the client.
#
# The value is the REST base URL and MUST include the `/api` prefix (the backend
# mounts every route under /api).
#
# Local dev (iOS sim / web): http://localhost:4001/api
# Android emulator: http://10.0.2.2:4001/api (10.0.2.2 = host machine from the emulator)
# Physical phone via Expo Go on same Wi-Fi: http://<YOUR_LAN_IP>:4001/api
#   Find your LAN IP with: `ip route get 1 | awk '{print $7; exit}'` on Linux,
#   or `ipconfig getifaddr en0` on macOS.

EXPO_PUBLIC_BACKEND_URL=http://localhost:4001/api
