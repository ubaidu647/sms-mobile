# Copy to `.env` and edit. Vars MUST be prefixed with EXPO_PUBLIC_ to be readable on the client.
# EXPO_PUBLIC_* values are INLINED when the bundle is built — rebuild after changing them.
#
# EXPO_PUBLIC_BACKEND_URL — the REST base URL; MUST include the `/api` prefix
# (the backend mounts every route under /api).
#
# Release builds (__DEV__ false): REQUIRED and MUST be https://. The app throws
# at startup otherwise (src/config/env.js), e.g.
#   EXPO_PUBLIC_BACKEND_URL=https://api.nodecampus.online/api
#
# EXPO_PUBLIC_ALLOW_INSECURE_BACKEND — QA/staging escape hatch ONLY. Set to 1 to
# let a RELEASE build use a plain http:// backend (e.g. a staging box without
# TLS); the app logs a loud warning at startup. The URL must still be set and
# valid. NEVER set this for a store / production build.
#   EXPO_PUBLIC_ALLOW_INSECURE_BACKEND=1
#
# Development: optional; falls back to http://localhost:4000/api (the backend's
# default PORT — if your backend .env sets another PORT, use that port here).
#   iOS sim / web:         http://localhost:4000/api
#   Android emulator:      http://10.0.2.2:4000/api (10.0.2.2 = host machine from the emulator)
#   Physical phone via Expo Go on same Wi-Fi: http://<YOUR_LAN_IP>:4000/api
#     Find your LAN IP with: `ip route get 1 | awk '{print $7; exit}'` on Linux,
#     or `ipconfig getifaddr en0` on macOS.

EXPO_PUBLIC_BACKEND_URL=http://localhost:4000/api

# EXPO_PUBLIC_ACADEMIC_YEAR_START_MONTH — optional, 1–12 (default 4 = April).
# Only a fallback: once signed in the app uses the month the API reports for the
# school (GET /schools/settings → effectiveAcademicYearStartMonth). It applies
# before that answers, if it fails, or for a user without a school. Keep it equal
# to the backend's ACADEMIC_YEAR_START_MONTH.
# EXPO_PUBLIC_ACADEMIC_YEAR_START_MONTH=4
